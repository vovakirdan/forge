# Base and CLI identities are pinned; each completed build is referenced by its
# resulting digest in ExecutionProfile/RunSpec, never by this mutable local tag.
FROM docker.io/library/node@sha256:4bd6219054c8bebcd26a66bfd8ca0bd6e1024b4b97474c59bb7ee3bbcbef4fe8 AS providers
WORKDIR /opt/forge-runtimes
COPY infra/runtime/package.json infra/runtime/package-lock.json ./
RUN npm ci --ignore-scripts --omit=dev --no-audit --no-fund && node node_modules/opencode-ai/postinstall.mjs && node node_modules/@anthropic-ai/claude-code/install.cjs

FROM docker.io/library/ubuntu@sha256:1e0a86e57d247923571b75e0aaf48a1449cf8c543d51fb3e07a4a7d7bfa79316
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git && apt-get clean
COPY --from=providers /usr/local/bin/node /usr/local/bin/node
COPY --from=providers /opt/forge-runtimes /opt/forge-runtimes
RUN ln -s /opt/forge-runtimes/node_modules/.bin/codex /usr/local/bin/codex && ln -s /opt/forge-runtimes/node_modules/.bin/opencode /usr/local/bin/opencode && ln -s /opt/forge-runtimes/node_modules/.bin/claude /usr/local/bin/claude && mkdir -p /run/forge /run/forge-input /run/forge-evidence /run/forge-gateway /run/forge-secrets /workspace
COPY target/debug/forge-runner /usr/local/bin/forge-runner
COPY target/debug/forge-opencode-driver /usr/local/bin/forge-opencode-driver
COPY target/debug/forge-claude-driver /usr/local/bin/forge-claude-driver
COPY target/debug/forge-codex-driver /usr/local/bin/forge-codex-driver
RUN chmod 755 /usr/local/bin/forge-runner /usr/local/bin/forge-opencode-driver /usr/local/bin/forge-claude-driver /usr/local/bin/forge-codex-driver
LABEL org.opencontainers.image.title="Forge managed runtime" \
      io.forge.codex.version="0.153.2" \
      io.forge.opencode.version="1.18.29" \
      io.forge.claude.version="2.1.263" \
      io.forge.node.version="24.14.0"
ENTRYPOINT ["/usr/local/bin/forge-runner"]
